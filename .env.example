# Supabase Configuration
# 1. Create a project at https://supabase.com
# 2. Run supabase-schema.sql in your Supabase SQL Editor
# 3. Run supabase-migration.sql after the schema
# 4. Copy your project URL and keys from Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=5000

# CORS allowed origins (comma-separated)
# Use your deployed frontend domain(s) in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Admin credentials for admin panel login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-admin-password

# Rate limiting (recommended in production / required on serverless)
# Shares rate-limit counters across all instances. Create a free database at
# https://console.upstash.com (or the Vercel Upstash integration) and copy the
# REST URL + token. Leave unset locally to use per-process in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
ENABLE_SWAGGER=false
NODE_ENV=production
